# Never commit real credentials. Configure these in the server secret manager.
BRIDGE_API_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
GEMINI_API_KEY=
# Set this to a model ID confirmed available to your Google AI project.
GEMINI_MODEL=

# Comma-separated IDs of explicitly approved Drive folders.
# Share only these folders with the service-account email as Viewer.
GOOGLE_DRIVE_ALLOWED_FOLDER_IDS=

# Limits
MAX_FILES_PER_QUERY=5
MAX_CHARS_PER_FILE=18000
MAX_TOTAL_CONTEXT_CHARS=60000
REQUEST_TIMEOUT_SECONDS=30
