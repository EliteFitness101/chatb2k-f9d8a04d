# =============================================================================
# ResoFlex Sovereign — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Server-only secrets are read via process.env inside server functions.
# VITE_*  vars are public (bundled into the client) — safe for browsers.
# =============================================================================

# ---------- Lovable Cloud / Supabase (auto-provisioned) ----------------------
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."           # anon / publishable key
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."          # SERVER ONLY — bypasses RLS
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# ---------- Paystack (NGN rail — primary) ------------------------------------
# Get keys at https://dashboard.paystack.com/#/settings/developers
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ---------- PalmPay (optional secondary NGN rail) ----------------------------
PALMPAY_MERCHANT_ID=""
PALMPAY_PUBLIC_KEY=""
PALMPAY_SECRET_KEY=""

# ---------- Crypto rail (optional — NOWPayments / Coinbase Commerce) ---------
CRYPTO_PROVIDER="nowpayments"                       # nowpayments | coinbase
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
COINBASE_COMMERCE_API_KEY=""
COINBASE_COMMERCE_WEBHOOK_SECRET=""

# ---------- Shopify (global rail for physical goods) -------------------------
SHOPIFY_ACCESS_TOKEN=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"

# ---------- Resend (transactional email) -------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Sovereign <no-reply@resoflex.com>"

# ---------- Ayrshare (social auto-posting on milestones) ---------------------
AYRSHARE_API_KEY=""

# ---------- Lovable AI Gateway (LLM access — no key needed in Lovable Cloud) -
LOVABLE_API_KEY=""

# ---------- Hub Locations (comma-separated city,country pairs) ---------------
# The geo router picks the nearest hub based on the visitor's country.
HUB_LAGOS="Lagos,NG"
HUB_LONDON="London,GB"
HUB_NEW_YORK="New York,US"
HUB_DUBAI="Dubai,AE"
HUB_JOHANNESBURG="Johannesburg,ZA"
HUB_GLOBAL_HQ="Lagos,NG"

# ---------- Site / Deploy ----------------------------------------------------
VITE_SITE_URL="https://resoflex-global.lovable.app"
NODE_ENV="development"