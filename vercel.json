{
  "version": 2,
  "builds": [
    {
      "src": "chatb2k_github_orchestrator.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/health",
      "destination": "chatb2k_github_orchestrator.py"
    },
    {
      "src": "/webhook/github",
      "destination": "chatb2k_github_orchestrator.py"
    }
  ]
}
