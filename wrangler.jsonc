{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatb2k-f9d8a04d",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "@tanstack/react-start/server-entry",
  "vars": {
    "NODE_ENV": "production"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "xbang-media-canonical"
    }
  ]
}
